{
  "title": "Software Inventory — Fleet Overview",
  "uid": "sw-inventory-overview",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "tags": ["sw-inventory", "node_exporter"],
  "timezone": "",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "5m",
  "links": [
    {
      "title": "Host Detail →",
      "type": "link",
      "url": "/d/sw-inventory-host-detail",
      "icon": "dashboard",
      "tooltip": "Drill into one host",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Datasource",
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes Reporting",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "count(node_sw_inventory_scan_timestamp_seconds)", "legendFormat": "nodes", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scan Failures",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "count(node_sw_inventory_scan_success == 0) or vector(0)", "legendFormat": "failed", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodes Needing Reboot",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "count(node_reboot_required == 1) or vector(0)", "legendFormat": "reboot", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pending Security Updates (fleet)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(node_packages_upgradable{type=\"security\"})", "legendFormat": "security updates", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pending Updates — All (fleet)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(node_packages_upgradable{type=\"all\"})", "legendFormat": "all updates", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Kernel Reboot Pending",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "count(node_kernel_update_pending == 1) or vector(0)", "legendFormat": "kernel pending", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Per-Host Summary",
      "description": "One row per node: OS, kernel, package counts, pending updates, reboot/kernel status. Click a Host cell to drill into it.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "node_packages_total", "format": "table", "instant": true, "refId": "A" },
        { "expr": "node_packages_upgradable{type=\"all\"}", "format": "table", "instant": true, "refId": "B" },
        { "expr": "node_packages_upgradable{type=\"security\"}", "format": "table", "instant": true, "refId": "C" },
        { "expr": "node_reboot_required", "format": "table", "instant": true, "refId": "D" },
        { "expr": "node_kernel_update_pending", "format": "table", "instant": true, "refId": "E" },
        { "expr": "time() - node_sw_inventory_scan_timestamp_seconds", "format": "table", "instant": true, "refId": "F" },
        { "expr": "node_os_info", "format": "table", "instant": true, "refId": "G" },
        { "expr": "node_kernel_latest_installed_info", "format": "table", "instant": true, "refId": "H" }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "instance", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true, "Time 6": true, "Time 7": true,
              "job": true, "__name__": true, "type": true, "source": true,
              "container": true, "endpoint": true, "namespace": true, "pod": true, "service": true,
              "id": true, "id_like": true, "name": true, "version_id": true, "version_codename": true,
              "version": true, "version 1": true,
              "Value #G": true, "Value #H": true
            },
            "renameByName": {
              "instance": "Host",
              "Value #A": "Packages Total",
              "Value #B": "Upgradable (all)",
              "Value #C": "Upgradable (security)",
              "Value #D": "Reboot Required",
              "Value #E": "Kernel Pending",
              "Value #F": "Last Scan (s ago)",
              "pretty_name": "OS",
              "running": "KERNEL-VERSION"
            },
            "indexByName": {
              "instance": 0, "pretty_name": 1, "running": 2,
              "Value #A": 3, "Value #B": 4, "Value #C": 5, "Value #D": 6, "Value #E": 7, "Value #F": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "color-background" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Upgradable (security)" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 1 }] } }] },
          { "matcher": { "id": "byName", "options": "Reboot Required" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] } }] },
          { "matcher": { "id": "byName", "options": "Kernel Pending" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] } }] },
          {
            "matcher": { "id": "byName", "options": "Host" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View host detail",
                    "url": "/d/sw-inventory-host-detail?var-host=${__value.text}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Installed Software — All Nodes (allowlisted)",
      "description": "Every allowlisted package/version on every node. Filter/sort by Host or Name in the column header.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "node_software_info", "format": "table", "instant": true, "refId": "A" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "job": true, "__name__": true, "container": true, "endpoint": true, "namespace": true, "pod": true, "service": true },
            "renameByName": { "instance": "Host", "name": "Package", "version": "Version", "source": "Source" },
            "indexByName": { "instance": 0, "name": 1, "version": 2, "source": 3 }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Host" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View host detail",
                    "url": "/d/sw-inventory-host-detail?var-host=${__value.text}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
